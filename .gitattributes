# 统一所有文本文件换行符为 LF
* text=auto eol=lf

# 源码与文档统一 LF
*.vue   text eol=lf
*.ts    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.mts   text eol=lf
*.cts   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.svg   text eol=lf

# 配置文件统一 LF
.gitignore      text eol=lf
.gitattributes  text eol=lf
.npmrc          text eol=lf
.editorconfig   text eol=lf

# 二进制文件不转
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.db    binary
*.woff  binary
*.woff2 binary
*.eot   binary
*.ttf   binary
*.otf   binary
