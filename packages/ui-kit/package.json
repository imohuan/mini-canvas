{
  "name": "@mini-canvas/ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./preview": {
      "types": "./src/preview/index.ts",
      "default": "./src/preview/index.ts"
    },
    "./vite": {
      "types": "./vite.ts",
      "default": "./vite.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.34",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@shikijs/langs": "^2.5.0",
    "@shikijs/themes": "^2.5.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "3.5.38",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "lucide-vue-next": "^1.0.0",
    "shiki": "^2.5.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.0.0",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8",
    "vue-sonner": "^2.0.9"
  }
}
