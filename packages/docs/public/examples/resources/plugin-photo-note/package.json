{
  "name": "@plume-canvas/plugin-photo-note",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "plume": {
    "title": "图片便签",
    "description": "演示 resources：选图 → put 拿引用 → resolve 拿地址 → 写进节点",
    "pluginName": "photo-note",
    "installable": true
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
