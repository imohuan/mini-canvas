{
  "name": "@plume-canvas/plugin-remember-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "plume": {
    "title": "记住面板",
    "description": "记住上次打开的面板（config 域）+ 画布草稿（canvas 域）+ 换后端重读",
    "pluginName": "remember-panel",
    "installable": true
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@plume-canvas/canvas-base": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/kernel": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^3.0.0"
  }
}

