{
  "name": "@plume-canvas/canvas-render",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": "./dist/*"
    }
  },
  "sideEffects": [
    "*.css",
    "./dist/*.css"
  ],
  "peerDependencies": {
    "@vue-flow/core": "^1.48.2",
    "vue": "^3.5.34"
  },
  "dependencies": {
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "@plume-canvas/vue-render": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue-flow/core": "^1.48.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.0.0",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  }
}
