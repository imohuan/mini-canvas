{
  "name": "@plume-canvas/plugin-bottom-bar",
  "version": "0.1.11",
  "type": "module",
  "plume": {
    "title": "底部状态栏",
    "description": "画布底部的状态栏：按项目替换整套底栏内容，支持插件注册自定义动作按钮，实时显示 Agent 任务的执行进度；自带常用工具入口、快捷操作与通知入口，是画布内交互的总控台。",
    "pluginName": "bottom-bar",
    "builtin": true,
    "web": {
      "entry": "dist/web.js"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "watch": "node scripts/watch.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@plume-canvas/plugin-sdk": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "@plume-canvas/editor": "workspace:*",
    "vue-draggable-plus": "^0.6.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "3.5.38",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "vue-draggable-plus": "^0.6.1"
  }
}
