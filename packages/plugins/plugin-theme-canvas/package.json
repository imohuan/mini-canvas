{
  "name": "@plume-canvas/plugin-theme-canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "plume": {
    "title": "主题画布外观",
    "description": "默认主题的画布半边：节点壳 / 连线 / 背景 / 节点上下工具栏（进画布才启动）",
    "pluginName": "theme-canvas",
    "builtin": true
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build"
  },
  "peerDependencies": {
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/ui-kit-shadcn": "workspace:*",
    "@vue-flow/core": "^1.48.2",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@plume-canvas/canvas-base": "workspace:*",
    "@plume-canvas/theme-contract": "workspace:*",
    "@plume-canvas/ui-kit-shadcn": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue-flow/core": "^1.48.2",
    "@vue/server-renderer": "3.5.38",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  },
  "dependencies": {
    "@plume-canvas/canvas-base": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "@plume-canvas/theme-contract": "workspace:*",
    "@plume-canvas/ui-kit-shadcn": "workspace:*",
    "lucide-vue-next": "^1.0.0"
  }
}
