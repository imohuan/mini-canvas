{
  "name": "@plume-canvas/plugin-node-text",
  "version": "0.1.4",
  "type": "module",
  "plume": {
    "title": "文本节点",
    "description": "文本节点：双击编辑 + 生成",
    "pluginName": "text",
    "builtin": true
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:hmr": "vite --config vite.dev.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@plume-canvas/plugin-sdk": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "3.5.38",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
