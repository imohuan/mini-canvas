{
  "name": "@mini-canvas/plugin-hot-reload-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "miniCanvas": {
    "title": "热重载试验台",
    "description": "开发用：验证热重载链路是否真的生效。装上后画布右上角有一块显眼的演示卡片，改源码重新 build 后应自动变样",
    "pluginName": "hot-reload-demo",
    "installable": true,
    "defaultInstalled": false
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mini-canvas/canvas-base": "workspace:*",
    "lucide-vue-next": "^1.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  }
}
