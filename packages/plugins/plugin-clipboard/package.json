{
  "name": "@plume-canvas/plugin-clipboard",
  "version": "0.1.5",
  "type": "module",
  "plume": {
    "title": "复制粘贴",
    "description": "Ctrl/Cmd+C/V/X/D",
    "pluginName": "clipboard",
    "builtin": true,
    "web": {
      "entry": "dist/web.js"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@plume-canvas/plugin-sdk": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
