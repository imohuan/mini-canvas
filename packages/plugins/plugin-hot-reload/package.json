{
  "name": "@plume-canvas/plugin-hot-reload",
  "version": "0.1.1",
  "type": "module",
  "plume": {
    "title": "热重载",
    "description": "调试用：把 watch 上报过的插件列出来，看监听在不在线，一键重装 / 卸载。安装后设置里多出「调试插件」页。",
    "pluginName": "hot-reload",
    "installable": true,
    "web": {
      "entry": "dist/web.js"
    },
    "server": {
      "entry": "dist/server.js"
    },
    "serverPermissions": []
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build && node scripts/build-server.mjs",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@plume-canvas/canvas-render": "workspace:*",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "esbuild": "0.28.2",
    "lucide-vue-next": "^1.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.16",
    "vite-plugin-css-injected-by-js": "3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
