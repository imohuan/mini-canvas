{
  "name": "@mini-canvas/plugin-node-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "miniCanvas": {
    "title": "可视化节点",
    "description": "一块空白画布：内容由 Agent 生成（HTML 就地渲染，可调画布接口）",
    "pluginName": "node-ui",
    "builtin": true
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build && node scripts/build-server.mjs",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "dev": "vite",
    "dev:hmr": "vite --config vite.dev.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mini-canvas/canvas-base": "workspace:*",
    "@mini-canvas/canvas-data": "workspace:*",
    "@mini-canvas/canvas-render": "workspace:*",
    "@mini-canvas/plugin-bottom-bar": "workspace:*",
    "@mini-canvas/kernel": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "3.5.38",
    "esbuild": "^0.28.2",
    "@mini-canvas/plugin-theme-default": "workspace:*",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  }
}

