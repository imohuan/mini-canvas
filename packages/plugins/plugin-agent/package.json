{
  "name": "@plume-canvas/plugin-agent",
  "version": "0.1.7",
  "type": "module",
  "plume": {
    "title": "Agent 对话助手",
    "description": "画布内对话助手：消息流 + 工具调用 + 设置页",
    "pluginName": "agent",
    "builtin": true,
    "serverBuiltin": true,
    "server": {
      "entry": "dist/server.js"
    },
    "web": {
      "entry": "dist/web.js"
    },
    "assets": [
      "dist/vendor-plugins"
    ]
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "vite build && node scripts/build-server.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "cn": "^0.5.1",
    "@vueuse/core": "^14.3.0",
    "reka-ui": "^2.11.0",
    "@prismshadow/penguin-core": "0.2.13",
    "hono": "^4.6.0",
    "yaml": "^2.9.1",
    "@plume-canvas/plugin-sdk": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "lucide-vue-next": "^1.0.0",
    "vue-draggable-plus": "^0.6.1",
    "@plume-canvas/editor": "workspace:*",
    "@types/node": "^24.12.3",
    "esbuild": "^0.28.2",
    "@plume-canvas/canvas-data": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "~6.0.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite": "^8.0.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cn": "^0.5.1",
    "@vueuse/core": "^14.3.0",
    "reka-ui": "^2.11.0",
    "@prismshadow/penguin-core": "0.2.13",
    "hono": "^4.6.0",
    "yaml": "^2.9.1",
    "lucide-vue-next": "^1.0.0",
    "vue-draggable-plus": "^0.6.1"
  }
}
