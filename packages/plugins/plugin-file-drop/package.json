{
  "name": "@plume-canvas/plugin-file-drop",
  "version": "0.1.0",
  "type": "module",
  "plume": {
    "title": "文件拖入",
    "description": "把图片/视频/文本拖到画布或粘贴进来即建节点",
    "pluginName": "file-drop",
    "builtin": true
  },
  "main": "./dist/web.js",
  "types": "./src/index.ts",
  "exports": {
    ".": "./dist/web.js",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@plume-canvas/plugin-sdk": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/kernel": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
