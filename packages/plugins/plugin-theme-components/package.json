{
  "name": "@plume-canvas/plugin-theme-components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "plume": {
    "title": "主题通用组件",
    "description": "默认主题的通用件：组件库目录 / 设置面板 / 外观变量 / 通知服务（应用级常驻）",
    "pluginName": "theme-components",
    "builtin": true
  },
  "main": "./src/index.ts",
