    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@plume-canvas/canvas-base": "workspace:*",
    "@plume-canvas/plugin-shortcut-manager": "workspace:*",
    "@plume-canvas/theme-contract": "workspace:*",
    "@plume-canvas/ui-kit-shadcn": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "3.5.38",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  },
  "dependencies": {
    "@ckpack/vue-color": "1.6.0",
    "@plume-canvas/canvas-base": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "@plume-canvas/theme-contract": "workspace:*",
    "@plume-canvas/ui-kit-shadcn": "workspace:*",
