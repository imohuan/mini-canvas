  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build"
  },
  "peerDependencies": {
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/ui-kit-shadcn": "workspace:*",
