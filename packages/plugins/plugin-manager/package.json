{
  "name": "@plume-canvas/plugin-manager",
  "version": "0.1.16",
  "type": "module",
  "plume": {
    "title": "插件管理",
    "description": "设置面板「插件」页：安装 / 卸载 / 重装第三方插件（清单来自云端或本地 dev 服务）",
    "pluginName": "plugin-manager",
    "builtin": true
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/plugin-sdk": "workspace:*",
    "@types/dompurify": "^3.2.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "lucide-vue-next": "^1.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/plugin-sdk": "workspace:*",
    "dompurify": "^3.4.18",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.2.1"
  }
