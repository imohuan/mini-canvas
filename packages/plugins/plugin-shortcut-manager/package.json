{
  "name": "@plume-canvas/plugin-shortcut-manager",
  "version": "0.1.4",
  "type": "module",
  "plume": {
    "title": "快捷键",
    "description": "快捷键帮助面板与设置页的快捷键配置（Ctrl/Cmd+/ 开合）",
    "pluginName": "shortcut-settings"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@plume-canvas/plugin-sdk": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@plume-canvas/plugin-sdk": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*"
  }
}
