{
  "name": "@plume-canvas/plugin-cursor-effect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "plume": {
    "title": "光标特效",
    "description": "画布光标样式 + 跟随特效 + 点击特效（烟花/星芒/彩纸…），带可视化设置页",
    "pluginName": "cursor-effect",
    "installable": true
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:vue": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@plume-canvas/canvas-base": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "lucide-vue-next": "^1.0.0"
  },
  "peerDependencies": {
    "@plume-canvas/canvas-render": "workspace:*",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "3.5.38",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  }
}

