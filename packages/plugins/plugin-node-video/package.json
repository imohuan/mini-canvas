{
  "name": "@plume-canvas/plugin-node-video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "plume": {
    "title": "视频节点",
    "description": "视频节点：播放 / 裁剪 / 剪辑 / 截图 / 下载",
    "pluginName": "video",
    "builtin": true,
    "serverPermissions": []
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build && node scripts/build-server.mjs",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plume-canvas/canvas-base": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/kernel": "workspace:*",
    "@plume-canvas/plugin-theme-canvas": "workspace:*",
    "lucide-vue-next": "^1.0.0",
    "@plume-canvas/bar-contract": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/server-renderer": "3.5.38",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.34",
    "@plume-canvas/plugin-theme-components": "workspace:*"
  }
}
