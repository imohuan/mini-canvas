{
  "name": "@plume-canvas/plugin-cloud-client",
  "version": "0.1.4",
  "type": "module",
  "plume": {
    "title": "云端连接",
    "description": "连上 cloud-server 后台：画布存档 / 生成动作 / 生成历史 / 实时跟随（不装它则画布只有本地能力）",
    "pluginName": "cloud-client",
    "installable": true,
    "defaultInstalled": false
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@plume-canvas/plugin-sdk": "workspace:*",
    "@plume-canvas/canvas-render": "workspace:*",
    "@plume-canvas/canvas-data": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
