{
  "name": "@mini-canvas/plugin-cloud-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "miniCanvas": {
    "title": "云端连接",
    "description": "连上 cloud-server 后台：画布存档 / 生成动作 / 生成历史 / 实时跟随（不装它则画布只有本地能力）",
    "pluginName": "cloud-client",
    "installable": true,
    "web": { "format": "esm" },
    "defaultInstalled": false
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mini-canvas/canvas-base": "workspace:*",
    "@mini-canvas/canvas-render": "workspace:*",
    "lucide-vue-next": "^1.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@mini-canvas/canvas-data": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.6",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.0.0",
    "vue": "^3.5.34"
  }
}
