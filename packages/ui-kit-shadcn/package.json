{
  "name": "@mini-canvas/ui-kit-shadcn",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/host.css",
    "./shadcnFamilies": {
      "types": "./src/shadcnFamilies.ts",
      "default": "./src/shadcnFamilies.ts"
    },
    "./componentConfig": {
      "types": "./src/componentConfig.ts",
      "default": "./src/componentConfig.ts"
    },
    "./theme/fonts": {
      "types": "./src/theme/fonts.ts",
      "default": "./src/theme/fonts.ts"
    },
    "./vite-plugin-debug-loc": {
      "types": "./src/vite-plugin-debug-loc.ts",
      "default": "./src/vite-plugin-debug-loc.ts"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:preview": "vite build --outDir ../ui/dist/ui-kit --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "pnpm -C ../ui exec vitest run --root ../ui-kit-shadcn --passWithNoTests src/__tests__"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  },
  "dependencies": {
    "@lucide/vue": "^1.66.0",
    "@vuelor/picker": "^1.2.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "reka-ui": "^2.11.0",
    "tw-animate-css": "^1.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "shadcn-vue": "^2.9.0",
    "vue": "3.5.38",
    "vue-tsc": "^2.2.0"
  }
}
