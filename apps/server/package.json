{
  "name": "@plume-canvas/server",
  "version": "0.1.4",
  "type": "module",
  "bin": {
    "plume-canvas": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "providers",
    "builtin-manifest.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*"
  },
  "scripts": {
    "start": "pnpm build:assets && pnpm build && pnpm serve",
    "dev": "tsx src/cli.ts serve -d ../../.plume --trusted-origin http://localhost:5288",
    "build": "pnpm typecheck && pnpm bundle",
    "bundle": "node scripts/bundle.mjs && tsc -p tsconfig.build.json && node scripts/bundle-dts.mjs",
    "gen:manifest": "node scripts/gen-builtin-manifest.mjs",
    "build:assets": "node scripts/build-assets-parallel.mjs",
    "prepack": "pnpm run build && pnpm gen:manifest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "node ./dist/cli.js serve",
    "e2e": "tsx e2e/cloud-e2e.ts",
    "e2e:mcp": "tsx e2e/mcp-e2e.ts",
    "e2e:realtime": "tsx e2e/realtime-e2e.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@prismshadow/penguin-core": "0.2.13",
    "hono": "^4.6.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.0",
    "@plume-canvas/plugin-agent": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.9",
    "@plume-canvas/kernel": "workspace:*",
    "@types/node": "^24.12.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vitest": "^3.0.0"
  },
  "prepack": "pnpm run build && pnpm gen:manifest"
}
