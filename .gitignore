# 通用规则：跨包相同的部分放这里；各包自己的产物写在包内 .gitignore。

# 依赖与日志
node_modules/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 编辑器 / 系统文件
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local

# 构建缓存与临时打包产物（包内另有同名规则，这里兜底根目录）
dist/
dist-ssr/
coverage/
*.tsbuildinfo
*.tgz

# 本地临时目录（探针、截图、一次性脚本）
.tmp/
.scratch/
_snap_tmp/
**/.tmp-verify/
**/e2e/out/
**/e2e/_shots/

# 本地分析用的浅克隆（用 codegraph 索引查询）
vendor/

# 本机 worktree
.worktrees/

# 运行数据根：画布 / 插件 / 令牌 / 日志，运行时生成，不入库
.plume/
.plume-*/
workspace/
**/.mini-canvas-legacy/

# 历史归档（v1 源码、旧文档、旧运行快照）已移出仓库，不再跟踪
backup/

# 开发过程文档里的临时扫描与截图（正式文档在 apps/docs）
docs/tmp/
docs/tmp/agent-coordination/*.log
docs/tmp/agent-coordination/*.json
docs/tmp/scan-*.cjs

# 根级调试残留
/_*.png
cdp-*.txt

