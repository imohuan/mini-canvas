# Worktrees
.worktrees/
# MCP 服务工作目录（画布 JSON 落盘，不入库）
workspace
packages/mcp-server/workspace

# cloud-server 的数据目录（画布数据 + 上传资源，运行时生成，不入库）
# 注：dist/ 与 *.tgz 已在上面被忽略，这里不重复列
.mini-canvas/
# cloud-server 数据目录的备份（手动/脚本备份出来的运行时快照，可能几百 MB，不入库）
.mini-canvas-backup-*/

# cloud-server 打包时收集的随包产物（由 scripts/bundle-assets.mjs 生成，不入库）
packages/cloud-server/assets/
# cloud-server 资源构建的源码指纹（由 scripts/build-assets-parallel.mjs 生成，机器本地缓存、不入库）
packages/cloud-server/.build-stamp.json

# 由插件 pnpm build 生成后复制到此，供 plugin-load demo 加载（勿手改）
packages/canvas-core-v2/demo-web/plugins/

# 经「插件管理 → NPM 市场」安装的插件副本（安装路由落盘，运行时产物，不入库）。
# 仓库内源码插件目录一律叫 plugin-<名字>；而 NPM 装的用发布包名 mini-canvas-plugin-<名字>，
# 两者命名不重叠，所以这条不会误伤源码包。
packages/plugins/mini-canvas-plugin-*

# 分析 VueFlow 源码用(浅克隆, 不入库); 用 codegraph 索引查询
vendor/

# 调试残留：截图 / 探针脚本 / 临时快照目录，都不是源码，不入库
.tmp-probe/
_snap_tmp/
packages/ui/_snap_tmp/
packages/ui/e2e/_shots/
packages/ui/e2e/_probe-*.mjs
docs/tmp/_scan/
/_*.png

# cloud-server 本地复现环境（机器本地，不入库）
packages/cloud-server/.repro/
