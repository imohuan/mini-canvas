# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

.chrome-v1
.chrome-ctx
.chrome-cmds

.codex-tmp
node_modules
dist
dist-ssr
*.local
deepseek-harness

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
